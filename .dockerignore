# ============================================================
# .dockerignore — keep the build context lean.
# Only files needed to BUILD the image should reach the daemon.
# Application source is bind-mounted at runtime via Compose.
# ============================================================

# Version control
.git
.gitignore

# Python artefacts
__pycache__
**/__pycache__
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info
dist/
build/
.eggs/
.tox/
.mypy_cache/
.pytest_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml

# Virtual environments
.venv
venv
env
ENV

# IDE / editor
.vscode
.idea
*.swp
*.swo
*.DS_Store
Thumbs.db

# Secrets — never in the image
.env

# Documentation and large binary assets
*.md
*.docx
*.pdf
*.mp4
*.png
*.jpg

# Test and dev artefacts
tests/
notebooks/
*.ipynb

# Docker files themselves (not needed inside the image)
docker-compose*.yml
Dockerfile*
.dockerignore
